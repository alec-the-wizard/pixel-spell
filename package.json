{
  "name": "pixel-spell",
  "private": true,
  "description": "A focused pixel art editor built with Svelte 5, Vite, shadcn-svelte and Lucide.",
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": {
    "name": "Alec Santos",
    "email": "alecsantos96@gmail.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.electron.json --noEmit",
    "bench": "node bench/run.mjs",
    "desktop:install": "node electron/ensure-electron.mjs",
    "desktop:build:main": "tsc -p tsconfig.electron.json",
    "desktop:dev": "npm run desktop:install && npm run desktop:build:main && node electron/dev.mjs",
    "desktop:build": "vite build --base=./ && npm run desktop:build:main",
    "desktop:start": "npm run desktop:install && npm run desktop:build && electron .",
    "desktop:icon": "node electron/make-icon.mjs",
    "desktop:package": "npm run desktop:install && npm run desktop:icon && npm run desktop:build && electron-builder"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "shadcn-svelte": "^1.8.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@lucide/svelte": "^1.70.0",
    "bits-ui": "^2.20.6",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "build": {
    "appId": "com.pixelspell.app",
    "productName": "Pixel Spell",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "pixelspell",
        "name": "Pixel Spell Project",
        "description": "Pixel Spell layered sprite project",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "PixelSpell-${version}-windows-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "PixelSpell-${version}-windows-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "artifactName": "PixelSpell-${version}-macos-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "maintainer": "Alec Santos <alecsantos96@gmail.com>",
      "artifactName": "PixelSpell-${version}-linux-${arch}.${ext}"
    }
  }
}
